{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. 색인 만들기 (app.index)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.index",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "2. API 서버 (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app"],
      "cwd": "${workspaceFolder}",
      "jinja": true
    },
    {
      "name": "3. 검색 3방식 비교 (서버를 끄고)",
      "type": "debugpy",
      "request": "launch",
      "module": "eval.compare_modes",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "4. 핵심 규칙 점검",
      "type": "debugpy",
      "request": "launch",
      "module": "tests.check_core",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "5. 평가 · 검색 지표 표 (eval.live, 서버를 끄고)",
      "type": "debugpy",
      "request": "launch",
      "module": "eval.live",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "6. 평가 · 답변 모으기 run (서버를 켜고, 키 필요)",
      "type": "debugpy",
      "request": "launch",
      "module": "eval.run_eval",
      "args": ["run"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "7. 평가 · 채점 score (키 필요)",
      "type": "debugpy",
      "request": "launch",
      "module": "eval.run_eval",
      "args": ["score"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
